<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.MainController"
      spacing="10">

    <padding>
        <Insets top="15" right="15" bottom="15" left="15"/>
    </padding>

    <Label fx:id="titleLabel" text="%app.title"
           style="-fx-font-size: 20px; -fx-font-weight: bold;"/>

    <HBox spacing="10">
        <Label text="%language.label"/>
        <ComboBox fx:id="languageBox" onAction="#changeLanguage"/>
    </HBox>

    <Separator/>

    <Label text="%temperature.title"
           style="-fx-font-size: 16px; -fx-font-weight: bold;"/>

    <TextField fx:id="tempInput" promptText="%temperature.prompt"/>

    <HBox spacing="10">
        <ComboBox fx:id="fromUnitBox" HBox.hgrow="ALWAYS"/>
        <ComboBox fx:id="toUnitBox" HBox.hgrow="ALWAYS"/>
    </HBox>

    <Button text="%temperature.convert"
            onAction="#convertTemperature" maxWidth="Infinity"/>

    <Label fx:id="tempResult" wrapText="true"/>

    <Label text="%history.title"
           style="-fx-font-weight: bold;"/>
    <ListView fx:id="historyList" prefHeight="100"/>

    <Separator/>

    <Label text="%travel.title"
           style="-fx-font-size: 16px; -fx-font-weight: bold;"/>

    <TextField fx:id="distanceField" promptText="%travel.distance"/>
    <TextField fx:id="speedField" promptText="%travel.speed"/>

    <Button text="%travel.calculate"
            onAction="#calculateTravel" maxWidth="Infinity"/>

    <Label fx:id="travelResult" wrapText="true"/>

</VBox>
